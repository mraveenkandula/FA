/company/*/attachments
/company/*/backup/*.sql
/company/*/backup/*.sql.gz
/company/*/pdf_files/*.pdf
/company/*/js_cache/*.js
/company/*/js_cache/*/*.js
/company/*/reporting
/company/*/images
/tmp
/vendor
/.phpunit.result.cache
/lang
# stock FrontAccounting ignores /modules wholesale (it expects third-party
# extensions to be explicitly opted in) - but every module directory in
# this fork is our own first-party code (modules/knb_*), not a third-party
# install, and git can't cleanly un-ignore deeply-nested files once a
# parent directory is excluded (each subfolder would need its own negation
# line). Simplest correct fix for a fork where modules/ is entirely ours:
# don't ignore it at all.
/themes
!/themes/default
!/themes/aqua
!/themes/cool
!/themes/knbgroup
!/lang/en_US
!/lang/new_language_template
installed_languages.inc
installed_extensions.php
config.php
config_db.php
!index.php

# Real customer/business data dumps (PII: names, phones, GSTINs) - never
# belongs in git, whatever directory it lands in.
/sql/*.sql
.DS_Store

# FA's own runtime-generated extension repository cache, not source.
/modules/_cache
